{
  "openapi": "3.0.0",
  "paths": {
    "/api/v1/dioceses": {
      "get": {
        "operationId": "listDioceses",
        "parameters": [
          {
            "name": "cursor",
            "required": false,
            "in": "query",
            "description": "The nextCursor of the previous page; omit for the first page",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "limit",
            "required": false,
            "in": "query",
            "schema": {
              "minimum": 1,
              "maximum": 100,
              "default": 50,
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DiocesePageDto"
                }
              }
            }
          },
          "400": {
            "description": "Invalid cursor or limit",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDto"
                }
              }
            }
          },
          "default": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDto"
                }
              }
            }
          }
        },
        "summary": "List published dioceses, by name",
        "tags": [
          "dioceses"
        ]
      }
    },
    "/api/v1/admin/auth/login": {
      "post": {
        "description": "Super admins get status mfa_required and must complete /login/mfa.",
        "operationId": "adminLogin",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequestDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LoginResultDto"
                }
              }
            }
          },
          "401": {
            "description": "Invalid email or password",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDto"
                }
              }
            }
          },
          "429": {
            "description": "Rate limit exceeded",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDto"
                }
              }
            }
          },
          "default": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDto"
                }
              }
            }
          }
        },
        "summary": "Sign in with email and password",
        "tags": [
          "admin-auth"
        ]
      }
    },
    "/api/v1/admin/auth/login/mfa": {
      "post": {
        "operationId": "adminLoginMfa",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/MfaLoginRequestDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthSessionDto"
                }
              }
            }
          },
          "401": {
            "description": "Expired MFA token or invalid code",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDto"
                }
              }
            }
          },
          "429": {
            "description": "Rate limit exceeded",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDto"
                }
              }
            }
          },
          "default": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDto"
                }
              }
            }
          }
        },
        "summary": "Complete a super admin sign-in with a TOTP code",
        "tags": [
          "admin-auth"
        ]
      }
    },
    "/api/v1/admin/auth/refresh": {
      "post": {
        "operationId": "adminRefresh",
        "parameters": [
          {
            "name": "X-Requested-With",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "XMLHttpRequest"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthSessionDto"
                }
              }
            }
          },
          "401": {
            "description": "Missing, expired, revoked or reused refresh token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDto"
                }
              }
            }
          },
          "403": {
            "description": "Missing X-Requested-With header",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDto"
                }
              }
            }
          },
          "429": {
            "description": "Rate limit exceeded",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDto"
                }
              }
            }
          },
          "default": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDto"
                }
              }
            }
          }
        },
        "security": [
          {
            "cc_admin_refresh": []
          }
        ],
        "summary": "Exchange the refresh cookie for a new access token and a rotated cookie",
        "tags": [
          "admin-auth"
        ]
      }
    },
    "/api/v1/admin/auth/logout": {
      "post": {
        "operationId": "adminLogout",
        "parameters": [
          {
            "name": "X-Requested-With",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "XMLHttpRequest"
              ]
            }
          }
        ],
        "responses": {
          "204": {
            "description": ""
          },
          "403": {
            "description": "Missing X-Requested-With header",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDto"
                }
              }
            }
          },
          "429": {
            "description": "Rate limit exceeded",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDto"
                }
              }
            }
          },
          "default": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDto"
                }
              }
            }
          }
        },
        "security": [
          {
            "cc_admin_refresh": []
          }
        ],
        "summary": "End this device's session",
        "tags": [
          "admin-auth"
        ]
      }
    },
    "/api/v1/admin/auth/forgot-password": {
      "post": {
        "description": "Always 202, whether or not the email belongs to an admin.",
        "operationId": "adminForgotPassword",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ForgotPasswordRequestDto"
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": ""
          },
          "429": {
            "description": "Rate limit exceeded",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDto"
                }
              }
            }
          },
          "default": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDto"
                }
              }
            }
          }
        },
        "summary": "Email a password reset link",
        "tags": [
          "admin-auth"
        ]
      }
    },
    "/api/v1/admin/auth/reset-password": {
      "post": {
        "operationId": "adminResetPassword",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ResetPasswordRequestDto"
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": ""
          },
          "400": {
            "description": "Invalid or expired reset link, or a password that breaks the policy",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDto"
                }
              }
            }
          },
          "429": {
            "description": "Rate limit exceeded",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDto"
                }
              }
            }
          },
          "default": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDto"
                }
              }
            }
          }
        },
        "summary": "Set a new password with a reset link token; ends every session",
        "tags": [
          "admin-auth"
        ]
      }
    },
    "/api/v1/admin/auth/me": {
      "get": {
        "operationId": "adminMe",
        "parameters": [],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AdminProfileDto"
                }
              }
            }
          },
          "401": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDto"
                }
              }
            }
          },
          "429": {
            "description": "Rate limit exceeded",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDto"
                }
              }
            }
          },
          "default": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDto"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "The signed-in admin",
        "tags": [
          "admin-auth"
        ]
      }
    }
  },
  "info": {
    "title": "Catholic Companion API",
    "description": "",
    "version": "1",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      },
      "cc_admin_refresh": {
        "type": "apiKey",
        "in": "cookie",
        "name": "cc_admin_refresh"
      }
    },
    "schemas": {
      "DioceseType": {
        "type": "string",
        "enum": [
          "archdiocese",
          "diocese",
          "vicariate",
          "prefecture",
          "military_ordinariate"
        ]
      },
      "DiocesePublicationStatus": {
        "type": "string",
        "enum": [
          "hidden",
          "in_progress",
          "published"
        ]
      },
      "DioceseDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "slug": {
            "type": "string"
          },
          "type": {
            "allOf": [
              {
                "$ref": "#/components/schemas/DioceseType"
              }
            ]
          },
          "provinceId": {
            "type": "string",
            "format": "uuid",
            "nullable": true
          },
          "seatCity": {
            "type": "string"
          },
          "state": {
            "type": "string"
          },
          "publicationStatus": {
            "allOf": [
              {
                "$ref": "#/components/schemas/DiocesePublicationStatus"
              }
            ]
          }
        },
        "required": [
          "id",
          "name",
          "slug",
          "type",
          "provinceId",
          "seatCity",
          "state",
          "publicationStatus"
        ]
      },
      "DiocesePageDto": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/DioceseDto"
            }
          },
          "nextCursor": {
            "type": "string",
            "nullable": true,
            "description": "Pass as cursor for the next page; null on the last page"
          }
        },
        "required": [
          "items",
          "nextCursor"
        ]
      },
      "LoginRequestDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "maxLength": 254
          },
          "password": {
            "type": "string",
            "maxLength": 128
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "LoginStatus": {
        "type": "string",
        "enum": [
          "authenticated",
          "mfa_required"
        ]
      },
      "AdminRole": {
        "type": "string",
        "enum": [
          "super_admin",
          "admin",
          "diocese_admin",
          "content_editor"
        ]
      },
      "AdminStatus": {
        "type": "string",
        "enum": [
          "pending",
          "active",
          "suspended"
        ]
      },
      "AdminProfileDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "email": {
            "type": "string",
            "format": "email"
          },
          "name": {
            "type": "string"
          },
          "role": {
            "allOf": [
              {
                "$ref": "#/components/schemas/AdminRole"
              }
            ]
          },
          "dioceseScopeId": {
            "type": "string",
            "format": "uuid",
            "nullable": true
          },
          "status": {
            "allOf": [
              {
                "$ref": "#/components/schemas/AdminStatus"
              }
            ]
          }
        },
        "required": [
          "id",
          "email",
          "name",
          "role",
          "dioceseScopeId",
          "status"
        ]
      },
      "AuthSessionDto": {
        "type": "object",
        "properties": {
          "accessToken": {
            "type": "string",
            "description": "Bearer token for the Authorization header; keep it in memory only"
          },
          "accessTokenExpiresAt": {
            "type": "string",
            "format": "date-time"
          },
          "admin": {
            "$ref": "#/components/schemas/AdminProfileDto"
          }
        },
        "required": [
          "accessToken",
          "accessTokenExpiresAt",
          "admin"
        ]
      },
      "LoginResultDto": {
        "type": "object",
        "properties": {
          "status": {
            "allOf": [
              {
                "$ref": "#/components/schemas/LoginStatus"
              }
            ]
          },
          "session": {
            "nullable": true,
            "description": "Set when authenticated",
            "type": "object",
            "allOf": [
              {
                "$ref": "#/components/schemas/AuthSessionDto"
              }
            ]
          },
          "mfaToken": {
            "type": "string",
            "nullable": true,
            "description": "Set when mfa_required: send it with the code to /login/mfa within 5 minutes"
          }
        },
        "required": [
          "status",
          "session",
          "mfaToken"
        ]
      },
      "MfaLoginRequestDto": {
        "type": "object",
        "properties": {
          "mfaToken": {
            "type": "string",
            "description": "The mfaToken from a login that returned status mfa_required"
          },
          "code": {
            "type": "string",
            "pattern": "^\\d{6}$",
            "description": "Six-digit code from the authenticator app"
          }
        },
        "required": [
          "mfaToken",
          "code"
        ]
      },
      "ForgotPasswordRequestDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "maxLength": 254
          }
        },
        "required": [
          "email"
        ]
      },
      "ResetPasswordRequestDto": {
        "type": "object",
        "properties": {
          "token": {
            "type": "string",
            "description": "The token from the password reset link"
          },
          "password": {
            "type": "string",
            "minLength": 12,
            "maxLength": 128
          }
        },
        "required": [
          "token",
          "password"
        ]
      },
      "ErrorResponseDto": {
        "type": "object",
        "properties": {
          "statusCode": {
            "type": "number",
            "example": 400
          },
          "error": {
            "type": "string",
            "example": "Bad Request"
          },
          "message": {
            "type": "string",
            "example": "Validation failed"
          },
          "details": {
            "description": "Individual validation messages; empty otherwise",
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "requestId": {
            "type": "string",
            "description": "Matches the X-Request-Id header and the server log line"
          }
        },
        "required": [
          "statusCode",
          "error",
          "message",
          "details",
          "requestId"
        ]
      }
    }
  }
}
