NODE_ENV=development
PORT=3000

# Supabase transaction pooler (port 6543), used by the running API.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@<pooler-host>:6543/postgres
# Direct or session connection (port 5432), used by migrations only. Never 6543 (docs/03 §5.2).
MIGRATION_DATABASE_URL=postgresql://postgres:<password>@<direct-host>:5432/postgres
DATABASE_SSL=true

# Project ref of catholic-prod. A non-production build refuses to start if a database URL contains it.
PRODUCTION_DATABASE_REF=
