NODE_ENV=development
# PORT is the API's port and defaults to 3000. Leave it unset here: Nx passes this file to every
# task, and the back-office dev server would also take PORT and collide with the API.

# Local Docker database (`pnpm db:up`). The app and migrations share one connection.
DATABASE_URL=postgresql://companion:companion@localhost:5432/companion_dev
MIGRATION_DATABASE_URL=postgresql://companion:companion@localhost:5432/companion_dev
DATABASE_SSL=false

# To point a local run at a Supabase project instead (docs/07):
#   DATABASE_URL           transaction pooler, port 6543
#   MIGRATION_DATABASE_URL direct or session connection, port 5432 — never 6543
#   DATABASE_SSL=true

# Project ref of the production Supabase project. A non-production build refuses to start if a
# database URL contains it.
PRODUCTION_DATABASE_REF=

# Admin auth (task 1.1.5). Generate locally; staging and production keep theirs in the host's secrets.
#   JWT_ACCESS_SECRET:    openssl rand -base64 48
#   MFA_ENCRYPTION_KEY:   openssl rand -base64 32   (exactly 32 bytes, base64)
JWT_ACCESS_SECRET=
MFA_ENCRYPTION_KEY=
# Set only while rotating MFA_ENCRYPTION_KEY: the old key, so existing secrets still open.
MFA_ENCRYPTION_KEY_PREVIOUS=
# Password reset links point here.
BACK_OFFICE_URL=http://localhost:4200
# Optional: JWT_ACCESS_TTL_SECONDS (default 900), REFRESH_TOKEN_TTL_DAYS (default 30).
# Behind the hosting platform's load balancer, so rate limits see the client's address.
TRUST_PROXY=false
